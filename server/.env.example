# Copy to .env and fill in real values (never commit .env)

MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority
PORT=5000

# Comma-separated allowed frontend origins (Vercel + local dev)
CLIENT_URL=http://localhost:5173,https://learnify-azure-three.vercel.app

# Used later for login tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional startup admin seed (leave blank in production after GYN reset).
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# One-time production reset only (never commit real values).
# Must meet app password policy: 8+ chars, upper, lower, number, special.
# CONFIRM_PRODUCTION_RESET=yes npm run reset:production
GYN_ADMIN_PASSWORD=
GYN_INSTRUCTOR_PASSWORD=
GYN_STUDENT_PASSWORD=

# File uploads. Configure these on Render to store videos/files in Cloudinary instead of server memory/disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=learnify/lms
UPLOAD_MAX_FILE_MB=250

# Zoom Server-to-Server OAuth (institutional account for MVP)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom user id or email who hosts all Learnify meetings
ZOOM_HOST_USER_ID=
